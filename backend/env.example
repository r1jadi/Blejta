DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blejta?schema=public
PORT=7058
JWT_SECRET=supersecret_jwt_key_change_in_production
FRONTEND_URL=http://localhost:3000

# Email Configuration
# Choose one of the following options:

# Option 1: Gmail (requires App Password, not regular password)
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Option 2: SendGrid (recommended for production)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Option 3: Mailgun
# Get credentials from: https://app.mailgun.com/app/sending/domains
# EMAIL_SERVICE=mailgun
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-domain.com

# Option 4: AWS SES (Amazon Simple Email Service)
# Get credentials from AWS IAM Console
# EMAIL_SERVICE=ses
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=your-access-key
# AWS_SES_SECRET_KEY=your-secret-key

# Option 5: Outlook/Hotmail
# EMAIL_SERVICE=outlook
# OUTLOOK_USER=your-email@outlook.com
# OUTLOOK_PASSWORD=your-password

# Option 6: Generic SMTP (works with most email providers)
# EMAIL_SERVICE=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Email sender information (required for all options)
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Blejta

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Other Services
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@your_cloud
SMS_API_KEY=your_sms_key
